{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "bun run build:appstore"
  },
  "app": {
    "security": {
      "capabilities": [
        {
          "identifier": "msstore-main",
          "description": "Main SimplEOS window permissions for the Microsoft Store build. The Store delivers updates, so the updater and process permissions are left out.",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "opener:default",
            "window-state:default",
            "core:window:allow-start-dragging",
            "core:window:allow-start-resize-dragging",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-is-maximized",
            "core:window:allow-close",
            "core:window:allow-set-focus",
            "deep-link:default"
          ]
        },
        "sign-confirm"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false
  }
}
