{
  "name": "simpleos",
  "version": "2.0.0-alpha.3",
  "scripts": {
    "ng": "ng",
    "start": "bun scripts/with-supported-node.js ng serve --port 42024",
    "build": "bun scripts/with-supported-node.js ng build",
    "build:appstore": "bun scripts/with-supported-node.js ng build --configuration appstore",
    "watch": "bun scripts/with-supported-node.js ng build --watch --configuration development",
    "test": "bun scripts/with-supported-node.js ng test",
    "tauri": "tauri",
    "tauri:dev": "bun scripts/tauri-dev.js",
    "tauri:build": "node scripts/package-desktop.js",
    "tauri:build:raw": "tauri build",
    "tauri:build:win": "node scripts/package-desktop.js",
    "tauri:build:win:store": "node scripts/windows-msstore-package.js",
    "tauri:build:linux": "node scripts/package-desktop.js",
    "tauri:build:mac": "scripts/macos-package.sh",
    "tauri:build:mac:no-updater": "scripts/macos-package.sh --no-updater",
    "tauri:build:mac:universal": "scripts/macos-package.sh --universal",
    "tauri:build:mac:appstore": "scripts/macos-appstore-package.sh",
    "tauri:build:mac:appstore:local": "scripts/macos-appstore-local-build.sh",
    "tauri:build:mac:appstore:validate": "scripts/macos-appstore-package.sh --validate",
    "tauri:build:mac:appstore:upload": "scripts/macos-appstore-package.sh --upload",
    "tauri:install:mac:appstore": "scripts/macos-appstore-local-build.sh && scripts/macos-install-local.sh --appstore-local",
    "tauri:install:mac:appstore:open": "scripts/macos-appstore-local-build.sh && scripts/macos-install-local.sh --appstore-local --open",
    "mac:signing-identities": "security find-identity -v -p codesigning && security find-identity -v -p basic",
    "updater:selftest": "node scripts/updater-selftest.js",
    "updater:selftest:serve": "node scripts/updater-selftest.js serve",
    "updater:manifest": "node scripts/updater-manifest.js",
    "updater:publish": "node scripts/publish-updater.js",
    "updater:publish:dry": "node scripts/publish-updater.js --dry-run",
    "e2e": "bun run tests/e2e/test.ts",
    "e2e:run": "bun run tests/e2e/test.ts run",
    "e2e:test": "bun run tests/e2e/test.ts test",
    "e2e:clean": "bun run tests/e2e/test.ts clean",
    "e2e:rust": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --test e2e_wallet --test e2e_signing -- --test-threads=1",
    "e2e:rust:lib": "cd src-tauri && PATH=\"$HOME/.cargo/bin:$PATH\" cargo test --lib",
    "e2e:all": "bun run e2e:run && bun run e2e:rust"
  },
  "private": true,
  "packageManager": "bun@1.3.11",
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/router": "22.2.2",
    "@noble/hashes": "2.4.0",
    "@tauri-apps/api": "3.0.0-alpha.2",
    "@tauri-apps/plugin-deep-link": "3.0.0-alpha.2",
    "@tauri-apps/plugin-opener": "3.0.0-alpha.2",
    "@tauri-apps/plugin-process": "3.0.0-alpha.2",
    "@tauri-apps/plugin-store": "3.0.0-alpha.2",
    "@tauri-apps/plugin-updater": "3.0.0-alpha.2",
    "@wharfkit/antelope": "4.0.2",
    "@wharfkit/signing-request": "4.0.2",
    "echarts": "6.1.0",
    "pako": "3.0.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@tauri-apps/cli": "3.0.0-alpha.4",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
